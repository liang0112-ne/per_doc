# per_doc 后端环境变量示例
# 复制为 .env 后按需修改；不要把 .env 提交到仓库

PER_DOC_SITE_NAME=per_doc
PER_DOC_HOST=0.0.0.0
PER_DOC_PORT=8181
PER_DOC_DEBUG=false

PER_DOC_DB_ADAPTER=sqlite
PER_DOC_DB_PATH=./data/per_doc.db
PER_DOC_DB_PREFIX=md_

PER_DOC_SECRET_KEY=change-me-to-a-long-random-string
PER_DOC_SESSION_BACKEND=cookie
PER_DOC_SESSION_MAX_AGE=604800
PER_DOC_SESSION_COOKIE_NAME=per_doc_session
PER_DOC_ACCESS_COOKIE_NAME=per_doc_access
PER_DOC_ALLOW_REGISTER=true

PER_DOC_UPLOAD_DIR=./data/uploads
PER_DOC_MAX_UPLOAD_SIZE=104857600
PER_DOC_UPLOAD_EXTENSIONS=txt,md,pdf,png,jpg,jpeg,gif,zip

PER_DOC_ENABLE_EXPORT=false

PER_DOC_CORS_ORIGINS=*
